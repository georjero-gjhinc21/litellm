# .env is now generated by scripts/load_secrets_from_bitwarden.sh - this file
# just documents the shape for anyone who needs to inspect/debug it manually.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
UI_USERNAME=
UI_PASSWORD=
OPENCODE_API_KEY=

# Alternative to the above for OPENCODE_API_KEY specifically: the daily
# scripts/update_free_models.py updater (used by GitHub Actions, which
# can't run the `bw` CLI's interactive vault unlock) can instead pull it from
# Bitwarden **Secrets Manager** — a separate machine-account/API flow, not
# the personal vault load_secrets_from_bitwarden.sh uses above.
# Create a machine account in Bitwarden Secrets Manager with read access to a project:
# BITWARDEN_ORG_ID=your-organization-id
# BITWARDEN_ACCESS_TOKEN=your-machine-account-access-token
# BITWARDEN_SECRET_KEY=OPENCODE_API_KEY

# Optional paid providers - leave empty if not used
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=